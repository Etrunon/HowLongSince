<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="40dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/since" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#8AB4F8" android:textSize="15sp" android:textStyle="bold" android:paddingHorizontal="8dp" />
    <TextView android:id="@+id/reset" android:layout_width="40dp" android:layout_height="40dp"
        android:gravity="center" android:text="↻" android:textColor="#FFFFFF" android:textSize="20sp"
        android:contentDescription="Reset" />
</LinearLayout>
